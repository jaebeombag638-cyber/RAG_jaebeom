# Copy to .env. Leave the API key empty until ready.
OPENAI_API_KEY=
# Temporary answer-model choice; review access, cost and quality during practice.
ANSWER_MODEL=gpt-4.1-mini
# For Ubuntu training ES, use its HTTPS URL and a LOCAL copy of the HTTP CA.
ES_URL=http://localhost:9200
ES_API_KEY=
# Alternative to ES_API_KEY: a permitted ES account. Do not fill both methods.
ES_USERNAME=
ES_PASSWORD=
ES_CA_CERT=
ES_INDEX=jeju-rag-v1
# Empty means .cache/huggingface/hub in this project.
MODEL_CACHE=
# Optional local BGE-M3 snapshot directory; empty means BAAI/bge-m3.
MODEL_PATH=
